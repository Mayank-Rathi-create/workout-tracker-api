# Postgres connection (used in production/dev). Falls back to local SQLite if unset.
DATABASE_URL=postgresql+psycopg2://workout_user:workout_pass@localhost:5432/workout_tracker

# JWT settings
SECRET_KEY=change-this-to-a-long-random-string-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
